{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoREST Validation Error Response",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["field", "message"],
    "properties": {
      "field": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
